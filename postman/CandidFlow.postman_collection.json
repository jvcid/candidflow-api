{
  "info": {
    "name": "CandidFlow API",
    "description": "Coleção ordenada para validar o health check e todos os CRUDs do CandidFlow.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "candidateId", "value": "" },
    { "key": "jobId", "value": "" },
    { "key": "applicationId", "value": "" },
    { "key": "feedbackId", "value": "" },
    { "key": "testEmail", "value": "" },
    { "key": "hmacApiKey", "value": "candidflow-client" },
    { "key": "hmacSecret", "value": "COLOQUE_A_MESMA_CHAVE_DO_HMAC_SECRET" }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (pm.request.name === '02 - Criar candidato') pm.collectionVariables.set('testEmail', `joao.candidflow.${Date.now()}@example.com`);",
          "const rawPath = pm.variables.replaceIn(pm.request.url.getPath());",
          "const path = rawPath.startsWith('/') ? rawPath : `/${rawPath}`;",
          "if (!path.startsWith('/api/')) return;",
          "const CryptoJS = pm.require('npm:crypto-js@4.2.0');",
          "const timestamp = Math.floor(Date.now() / 1000).toString();",
          "const nonce = pm.variables.replaceIn('{{$guid}}');",
          "const query = pm.variables.replaceIn(pm.request.url.getQueryString() || '');",
          "const requestTarget = query ? `${path}?${query}` : path;",
          "const body = pm.request.body && pm.request.body.mode === 'raw'",
          "  ? pm.variables.replaceIn(pm.request.body.raw || '')",
          "  : '';",
          "const bodyHash = CryptoJS.SHA256(body).toString(CryptoJS.enc.Hex);",
          "const canonicalRequest = [pm.request.method.toUpperCase(), requestTarget, timestamp, nonce, bodyHash].join('\\n');",
          "const signature = CryptoJS.HmacSHA256(canonicalRequest, pm.collectionVariables.get('hmacSecret')).toString(CryptoJS.enc.Hex);",
          "pm.request.headers.upsert({ key: 'X-API-Key', value: pm.collectionVariables.get('hmacApiKey') });",
          "pm.request.headers.upsert({ key: 'X-Timestamp', value: timestamp });",
          "pm.request.headers.upsert({ key: 'X-Nonce', value: nonce });",
          "pm.request.headers.upsert({ key: 'X-Signature', value: signature });"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "01 - Health check",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/actuator/health"
      },
      "event": [{
        "listen": "test",
        "script": { "type": "text/javascript", "exec": [
          "pm.test('API está disponível', () => pm.response.to.have.status(200));",
          "pm.test('Status é UP', () => pm.expect(pm.response.json().status).to.eql('UP'));"
        ]}
      }]
    },
    {
      "name": "02 - Criar candidato",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"João Victor Martins Cid\",\n  \"email\": \"{{testEmail}}\",\n  \"phone\": \"85999999999\",\n  \"linkedinUrl\": \"https://www.linkedin.com/in/exemplo\",\n  \"githubUrl\": \"https://github.com/jvcid\"\n}"
        },
        "url": "{{baseUrl}}/api/candidates"
      },
      "event": [
        {
          "listen": "test",
          "script": { "type": "text/javascript", "exec": [
            "pm.test('Candidato criado', () => pm.response.to.have.status(201));",
            "if (pm.response.code === 201) pm.collectionVariables.set('candidateId', pm.response.json().id);"
          ]}
        }
      ]
    },
    {
      "name": "03 - Listar candidatos",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/candidates?page=0&size=20"
      },
      "event": [{
        "listen": "test",
        "script": { "type": "text/javascript", "exec": [
          "pm.test('Candidatos listados', () => pm.response.to.have.status(200));"
        ]}
      }]
    },
    {
      "name": "04 - Buscar candidato por ID",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/candidates/{{candidateId}}"
      },
      "event": [{
        "listen": "test",
        "script": { "type": "text/javascript", "exec": [
          "pm.test('Candidato encontrado', () => pm.response.to.have.status(200));"
        ]}
      }]
    },
    {
      "name": "05 - Atualizar candidato",
      "request": {
        "method": "PUT",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"João Victor Cid\",\n  \"email\": \"{{testEmail}}\",\n  \"phone\": \"85988888888\",\n  \"linkedinUrl\": \"https://www.linkedin.com/in/exemplo\",\n  \"githubUrl\": \"https://github.com/jvcid\"\n}"
        },
        "url": "{{baseUrl}}/api/candidates/{{candidateId}}"
      },
      "event": [{
        "listen": "test",
        "script": { "type": "text/javascript", "exec": [
